APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://starter:starter@localhost:54329/starter?sslmode=disable
DB_MAX_CONNS=10
LOG_LEVEL=info
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
DOCS_ENABLED=true

# 所有环境均使用数据库会话，配置生成邮件验证链接所用的前端地址。
AUTH_PROVIDERS_FILE=
FRONTEND_URL=https://localhost:3000
AUTH_SESSION_IDLE_TTL=30m
AUTH_SESSION_MAX_TTL=24h

# 可选的 OTLP/HTTP 导出，支持标准 OTEL_EXPORTER_OTLP_* 环境变量。
OTEL_ENABLED=false
# OTEL_ENABLED=true 时必须显式填写，建议区分 API 与 Worker。
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Worker 邮件队列空闲或故障时的轮询间隔。
MAIL_POLL_INTERVAL=1s
