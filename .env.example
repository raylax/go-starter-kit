APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://starter:starter@localhost:54329/starter?sslmode=disable
DB_MAX_CONNS=10
LOG_LEVEL=info
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
DOCS_ENABLED=true

# 仅用于本地演示；生产环境需要 AUTH_MODE=jwt 和 HTTPS 的 issuer/JWKS 地址。
AUTH_MODE=dev
DEV_AUTH_TOKEN=local-development-token
DEV_AUTH_SUBJECT=demo-user
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# 可选的 OTLP/HTTP 导出，支持标准 OTEL_EXPORTER_OTLP_* 环境变量。
OTEL_ENABLED=false
OTEL_SERVICE_NAME=go-starter-kit
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

